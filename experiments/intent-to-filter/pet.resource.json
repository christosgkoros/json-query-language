{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/intent-to-filter/pet.json",
  "title": "Pet",
  "description": "A pet listed in the store.",
  "$comment": "The resource schema for the experiment's fixture collection. It is NOT examples/pet.schema.json: the fixture in ../filter-to-sql/dataset.mjs carries four paths that file does not model — priceCents, costCents, the deliberately heterogeneous notes, and the two adversarially-named keys $rate and size.raw — and thirteen corpus cases query them. Modelling the fixture as it actually is keeps every arm's ceiling a property of the arm rather than of a mismatched schema.",
  "type": "object",
  "required": ["id", "name", "status"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name."
    },
    "species": {
      "type": "string",
      "enum": ["cat", "dog", "rabbit", "bird"],
      "description": "Taxon, coarse-grained."
    },
    "status": {
      "type": "string",
      "description": "Listing state.",
      "oneOf": [
        { "const": "available", "description": "Adoptable now." },
        { "const": "pending", "description": "An application is in review." },
        { "const": "sold", "description": "Adopted; kept for history." }
      ]
    },
    "born": {
      "type": "string",
      "format": "date",
      "description": "Date of birth, RFC 3339 full-date."
    },
    "weightKg": {
      "type": "number",
      "minimum": 0,
      "description": "Last recorded weight."
    },
    "neutered": {
      "type": "boolean",
      "description": "Whether the pet has been neutered."
    },
    "microchip": {
      "type": ["string", "null"],
      "description": "Chip number. Null where the pet is on record as unchipped; the property is absent where nobody has looked."
    },
    "tags": {
      "type": "array",
      "description": "Free-form labels used for browsing.",
      "items": { "type": "string" }
    },
    "notes": {
      "type": ["string", "number", "boolean", "object", "array", "null"],
      "description": "Unstructured staff annotation. Deliberately heterogeneous: every record holds a different JSON type here."
    },
    "priceCents": {
      "type": "integer",
      "minimum": 0,
      "description": "Asking price, in cents."
    },
    "costCents": {
      "type": "integer",
      "minimum": 0,
      "description": "What the shelter spent, in cents."
    },
    "$rate": {
      "type": "integer",
      "description": "Daily boarding rate. The property name really does begin with a dollar sign."
    },
    "size.raw": {
      "type": "string",
      "description": "Size code as supplied by the intake form. The property name really does contain a dot."
    },
    "shelter": {
      "type": "object",
      "description": "Where the pet is housed.",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "Shelter name." },
        "city": { "type": "string", "description": "Shelter city." },
        "capacity": { "type": "integer", "minimum": 0, "description": "Total kennels." }
      }
    },
    "vaccinations": {
      "type": "array",
      "description": "Vaccination history.",
      "items": {
        "type": "object",
        "required": ["vaccine", "administeredAt"],
        "properties": {
          "vaccine": {
            "type": "string",
            "enum": ["rabies", "distemper", "parvo"],
            "description": "Vaccine given."
          },
          "administeredAt": { "type": "string", "format": "date-time", "description": "When it was given." },
          "boosterDue": { "type": "string", "format": "date", "description": "When the booster is due." }
        }
      }
    },
    "internalNotes": {
      "type": "string",
      "description": "Staff-only. Not exposed to search.",
      "x-jql": false
    }
  }
}
